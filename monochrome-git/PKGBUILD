# Maintainer: Augusto Altenhofen
pkgname=monochrome-git
pkgver=r24.g3e4ec88
pkgrel=2
pkgdesc='Desktop client for Monochrome music streaming (git)'
arch=('x86_64')
url='https://github.com/monochrome-music/desktop-app'
license=('unknown')
depends=('libayatana-appindicator' 'webkit2gtk-4.1' 'gtk3')
makedepends=('bun' 'dpkg' 'node-gyp' 'rust')
provides=('monochrome')
conflicts=('monochrome' 'monochrome-bin')
source=('desktop-app::git+https://github.com/monochrome-music/desktop-app.git#branch=main')
b2sums=('SKIP')

pkgver() {
    cd "$srcdir/desktop-app"
    printf 'r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$srcdir/desktop-app"
    sed -i '/\.resizable(true)$/a\            .decorations(false)' src-tauri/src/lib.rs
}

build() {
    cd "$srcdir/desktop-app"
    export RUSTFLAGS="${RUSTFLAGS//-fuse-ld=lld/-fuse-ld=bfd} -C link-arg=-fuse-ld=bfd -l static=ring_core_0_17_14_"
    export LDFLAGS="${LDFLAGS//-fuse-ld=lld/-fuse-ld=bfd}"
    bun install --frozen-lockfile
    bun run tauri build --bundles deb
}

package() {
    local deb data_member
    deb=("$srcdir/desktop-app/src-tauri/target/release/bundle/deb/"*.deb)
    [[ -e ${deb[0]} ]] || { error 'Tauri build did not produce a Debian package'; return 1; }

    data_member=$(ar t "${deb[0]}" | awk '/^data\.tar\./ { print; exit }')
    [[ -n $data_member ]] || { error 'Debian archive has no data member'; return 1; }
    ar p "${deb[0]}" "$data_member" | bsdtar -xpf - -C "$pkgdir"
}
